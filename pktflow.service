# Template — install.sh substitutes __INSTALL_DIR__ / __LOG_DIR__ /
# __SERVICE_USER__ / __SERVICE_GROUP__ before installing to systemd.
# For a manual install, replace these placeholders yourself.
[Unit]
Description=pktFlow NetFlow Visualization Platform
Documentation=https://github.com/bsnwgit/pktflow
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__INSTALL_DIR__

Environment=PKTFLOW_CONFIG=__INSTALL_DIR__/config.yaml
Environment=PKTFLOW_INSTALL_DIR=__INSTALL_DIR__

# DuckDB requires single worker (one write connection allowed)
ExecStart=__INSTALL_DIR__/venv/bin/uvicorn app.main:app \
    --host 0.0.0.0 \
    --port 8080 \
    --workers 1 \
    --log-level info \
    --no-access-log

Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

StandardOutput=append:__LOG_DIR__/pktflow.log
StandardError=append:__LOG_DIR__/pktflow.log

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

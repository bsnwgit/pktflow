# Git
.git/
.gitignore

# Python runtime artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Frontend — rebuilt inside the Docker image; node_modules is platform-specific
frontend/dist/
frontend/node_modules/

# Runtime data — mounted as a named volume in production; never bake into image
*.db
*.duckdb
*.sqlite
*.log
ssl/

# Secrets and local config — passed via environment variables or .env
config.yaml
.env
.env.*
*.pem
*.pfx
*.p12
*.crt
*.key

# Internal / deployment-specific files (not needed inside the container)
CLAUDE.md
TODO.md
todo_widget.html
FLOW_VOLUME_ANALYSIS.md
ARCHITECTURE.md
O2_SSH_CONNECTION.md
PKTFLOW_LOGS_IMPLEMENTATION.md
backup.py
check_deploy.py
deploy_*.py
scripts/deploy_*.py
scripts/diag_*.py
scripts/fix_*.py
scripts/check_build.py

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

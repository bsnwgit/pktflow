# pktFlow — Docker environment variables
# Copy this file to .env and fill in your values before running docker compose up.
#
# IMPORTANT: Never commit .env to version control.

# ── Admin user (created on first run if no users exist) ──────────────────────
PKTFLOW_ADMIN_USER=admin
PKTFLOW_ADMIN_PASSWORD=changeme

# ── JWT signing key — CHANGE THIS before production use ──────────────────────
# Generate a strong key: openssl rand -hex 32
PKTFLOW_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── CORS (restrict to your dashboard origin in production) ───────────────────
# PKTFLOW_CORS_ORIGINS=["http://your-server-ip"]

# ── ClickHouse (leave defaults if using the bundled clickhouse service) ───────
# PKTFLOW_CLICKHOUSE_HOST=clickhouse
# PKTFLOW_CLICKHOUSE_PORT=9000
# PKTFLOW_CLICKHOUSE_DATABASE=pktflow
# PKTFLOW_CLICKHOUSE_USER=default
# PKTFLOW_CLICKHOUSE_PASSWORD=

# ── Port (80/443 are fixed in docker-compose.yml; change the app port here) ──
# PKTFLOW_PORT=80
